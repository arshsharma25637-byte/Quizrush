# ==============================================================================
# QuizRush — Environment Configuration Template
# ==============================================================================
# 1. Copy this file to `.env` for local development:
#      cp .env.example .env
# 2. Replace every YOUR_*_HERE value with your own project credentials.
# 3. For Vercel / Netlify hosting, add these same keys in your hosting
#    dashboard under Project Settings -> Environment Variables.
# NEVER commit your real `.env` file to a public repository.
# ==============================================================================

# --- Firebase Web App Configuration (Firebase Console -> Project Settings) ---
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID_HERE"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID_HERE"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID_HERE"

# Leave as "(default)" for standard Firebase projects, or enter a named Firestore DB ID.
VITE_FIREBASE_DATABASE_ID="(default)"

# --- Admin Panel Bootstrap Access ---
# Must match the verified Google account email you also set in `firestore.rules`.
VITE_ADMIN_EMAIL="YOUR_ADMIN_EMAIL@example.com"

# --- Ad Network Configuration (Optional: Adsterra 320x50 Banner) ---
# Leave as placeholders to hide live banner scripts until you are ready to monetize.
VITE_ADSTERRA_BANNER_KEY="YOUR_AD_BANNER_KEY_HERE"
VITE_ADSTERRA_BANNER_SCRIPT_URL="YOUR_AD_SCRIPT_URL_HERE"
